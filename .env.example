# =============================================================================
# 双色球预测平台 - 环境变量示例
# =============================================================================
# 复制本文件为 .env 并填入实际值:
#   cp .env.example .env
# 然后:
#   export $(cat .env | xargs)         # Linux/Mac
#   Get-Content .env | ForEach-Object { ... }   # Windows PowerShell
# 或者用 python-dotenv / direnv 自动加载
#
# 警告: 生产部署绝对不要使用默认值, SECRET_KEY 和 API_TOKEN 必须唯一
# =============================================================================

# ---------- 安全（生产必填） ----------

# Flask session 签名密钥 - 不设置会启动失败（DEBUG 模式自动生成临时密钥）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 写操作 API 鉴权 token - 前端调用时通过 X-API-Token 头传入
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# ---------- 运行模式 ----------

# Flask 调试模式. 生产必须设为 False, 否则 SECRET_KEY 未设置时会自动生成临时密钥
FLASK_DEBUG=True

# ---------- 日志 ----------

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- API 限流 ----------

# 限流存储 URI. 默认 memory:// (单进程). 多进程部署必须改 Redis
#   memory://                    单进程内存 (开发)
#   redis://localhost:6379/0     Redis (生产推荐)
#   redis://:password@host:6379/1  带密码的 Redis
LIMITER_STORAGE_URI=memory://

# Redis URL (当 LIMITER_STORAGE_URI=redis:// 时使用, 也可单独配置)
# REDIS_URL=redis://localhost:6379/0

# 全局每分钟请求数限制 (per-IP)
API_RATE_LIMIT=60

# 导入文本最大字节数 (KB)
MAX_JSON_SIZE=1024